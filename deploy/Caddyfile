# Tulona Caddyfile — auto-HTTPS via Let's Encrypt.
# __DOMAIN__ is substituted by deploy/bootstrap.sh from the DOMAIN env var.
# The document root is ONLY Laravel's public/ dir, so .env / storage internals
# are never web-accessible.

__DOMAIN__ www.__DOMAIN__ {
	# Laravel public directory
	root * /var/www/tulona/public
	encode zstd gzip

	# Route everything through index.php (Laravel front controller)
	php_fastcgi 127.0.0.1:9000

	# Serve static assets (product images under /storage, /build, favicons)
	file_server

	# Extra hardening: block any dotfile / config hit, just in case
	@hidden path_regexp (^|/)\.
	respond @hidden 404

	# Long-cache immutable assets (built CSS/JS has hashed filenames)
	header /build/* Cache-Control "public, max-age=31536000, immutable"
	# Product images are stored under public/storage -> storage/app/public
	header /storage/* Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Reasonable request size for the admin image uploader (default 8M too small)
	request_body {
		max_size 25MB
	}
}

# Access logs go to Caddy's stderr —  sudo journalctl -u caddy -f
