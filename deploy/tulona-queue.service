# Tulona database queue worker — written by deploy/bootstrap.sh to
# /etc/systemd/system/tulona-queue.service
#
# Handles import batches, affiliate generations and scrape jobs
# (QUEUE_CONNECTION=database). One worker is plenty for a free-tier VM.

[Unit]
Description=Tulona Laravel queue worker
Wants=network-online.target
After=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/tulona
ExecStart=/usr/bin/php /var/www/tulona/artisan queue:work --sleep=3 --tries=3 --timeout=110 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target