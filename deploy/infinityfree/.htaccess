# Tulona on InfinityFree — root .htaccess (goes in htdocs/, alongside app/)
# ---------------------------------------------------------------------------
# Layout: the whole Laravel project sits inside htdocs/. Only public/ should be
# reachable; everything else is rewritten through it.
#
#   /storage/* => storage/app/public/*   (replaces the storage:link symlink)
#   everything else => public/*
#
# LiteSpeed (InfinityFree) honours RewriteEngine rules set by .htaccess.

RewriteEngine On

# 1) Never let a direct hit expose the .env, caches or dot-directories.
RewriteRule ^\.env(\.local)?$ - [F,L,NC]

# 2) Serve the publicly-published files from the real storage dir.
#    (Product images land here via Laravel's "public" disk.)
RewriteRule ^storage/(.*)$ storage/app/public/$1 [END]

# 3) Everything else into Laravel's front controller.
RewriteRule (.*) public/$1 [L]