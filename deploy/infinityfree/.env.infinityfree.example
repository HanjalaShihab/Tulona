# Tulona live .env for InfinityFree
# =================================
# Copy to htdocs/.env (build.sh does this). Values marked ▲ MUST be edited.
# SCHEDULER_TOKEN drives the cron webhook — cron-job.org polls
#   https://<your-site>/tulona/cron/<SCHEDULER_TOKEN>

APP_NAME=Tulona
APP_ENV=production
# Do NOT regenerate: your existing SQLite data (sessions/encrypted values) keys off this.
APP_KEY=base64:Omua1ofK2bDjVaZ25Q0tySgSUWhEDBqCxO5jXNu2vF8=
APP_DEBUG=false
# ▲ Replace with your InfinityFree subdomain or custom domain (no trailing slash)
APP_URL=https://tulona.gt.tc

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# SQLite file lives at htdocs/database/database.sqlite (uploaded with your data)
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# InfinityFree has no queue workers → run jobs inline
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Optional: fill in real SMTP if you want password resets sent.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@tulona.test"
MAIL_FROM_NAME="${APP_NAME}"

# ▲ Pick a long random value, e.g. `php -r 'echo bin2hex(random_bytes(24));'`
SCHEDULER_TOKEN=3a222f6571ebbe3f33147ea0bea71095444c0eed4eafdfb3a328fa258609