# Tulona production environment template.
# bootstrap.sh copies this to /var/www/tulona/.env on first deploy.
# Replace DOMAIN and set a strong APP_KEY before going live.

APP_NAME=Tulona
APP_ENV=production
# Generate with: php artisan key:generate --show   (set on first deploy)
APP_KEY=
APP_DEBUG=false
# Use your real domain — must match the Caddyfile/server_name.
APP_URL=https://DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite lives on the VM disk at /var/www/tulona/database/database.sqlite
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Import/affiliate/scrape jobs run on the local database queue (see tulona-queue.service)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Optional: set a real SMTP mailer if you want password resets to be sent.
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="${APP_NAME}"